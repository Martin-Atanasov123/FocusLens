<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="expo.modules.focusblocker" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!--
       Brief PARTIAL_WAKE_LOCK held during limit checks so the CPU doesn't
       sleep between the UsageStats query and the BlockActivity launch.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Required for BootReceiver to restart limits after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
       Android 11+ package visibility: lets getApplicationLabel() resolve labels for
       any installed app that UsageStatsManager reports events for. Without this,
       pm.getApplicationInfo() throws NameNotFoundException for ~95% of packages.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application>
        <service
            android:name="expo.modules.focusblocker.FocusBlockerService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors and enforces user-configured daily screen-time limits and focus sessions for digital wellbeing" />
        </service>

        <activity
            android:name="expo.modules.focusblocker.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            tools:ignore="LockedOrientationActivity" />

        <receiver
            android:name="expo.modules.focusblocker.BootReceiver"
            android:enabled="true"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Restart service after an OTA update so limits survive Play Store updates -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
    </application>

</manifest>