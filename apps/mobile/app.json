{
  "expo": {
    "name": "FocusLens",
    "slug": "focuslens",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "focuslens",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2EDE3",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.focuslens.mobile",
      "permissions": [
        "android.permission.PACKAGE_USAGE_STATS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "focuslens",
              "host": "pair"
            }
          ]
        }
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "ae6489d4-66e4-449a-b817-92cd99f75ed8"
      }
    }
  }
}
