# Root-level EAS ignore — patterns relative to the monorepo root.
# EAS packages the entire monorepo in a pnpm workspace; exclude everything
# that is large and gets regenerated on the build server anyway.

# Mobile: generated native directories (CNG rebuilds them) + installed packages
apps/mobile/node_modules/
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/
apps/mobile/dist/
apps/mobile/build/
apps/mobile/modules/*/android/build/
apps/mobile/modules/*/android/.gradle/
apps/mobile/modules/*/android/.cxx/

# Extension: build output
apps/extension/dist/
apps/extension/node_modules/

# Desktop: Python caches
apps/desktop/__pycache__/
apps/desktop/.pytest_cache/

# Root workspace packages
node_modules/

# Large binaries
cloudflared.exe

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Local env files
.env
.env.local
.env.*.local
